---
const {
  logoUrl = '/favicon.svg',
  logoAlt = 'Lapwing Software',
  title,
  description,
  privacyUrl,
  termsUrl,
} = Astro.props;
---

<main class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-3xl items-center justify-center p-4 sm:min-h-[calc(100vh-8rem)]">
  <section class="w-full max-w-xl overflow-hidden rounded-3xl bg-white dark:bg-slate-900 shadow-sm transition-colors duration-300">
    <div class="px-6 pt-10 text-center sm:px-8">
      <img
        src={logoUrl}
        alt={logoAlt}
        width="64"
        height="64"
        class="mx-auto block w-16 h-16 rounded-2xl"
      />
    </div>

    <div class="px-6 pb-6 pt-6 text-center sm:px-8">
      <h1 class="m-0 text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        {title}
      </h1>

      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-slate-600 dark:text-slate-300">
        {description}
      </p>
    </div>

    <footer class="bg-slate-50 dark:bg-slate-800/50 px-6 py-6 text-center sm:px-8">
      <p class="m-0 text-xs text-slate-500 dark:text-slate-400">&copy; Lapwing Software</p>

      <p class="mt-2 text-xs">
        <a href={privacyUrl} class="font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white no-underline">
          Privacy Policy
        </a>
        <span class="mx-2 text-slate-400">|</span>
        <a href={termsUrl} class="font-medium text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white no-underline">
          Terms &amp; Conditions
        </a>
      </p>
    </footer>
  </section>
</main>
