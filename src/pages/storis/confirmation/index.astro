---
import '../../../styles/global.css';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='icon' href='/favicon.ico' />
    <title>Storis | Email Confirmed</title>
  </head>
  <body class='min-h-screen bg-[#F3F2EE] px-5 py-10 sm:px-6 sm:py-16'>
    <main
      class='mx-auto flex min-h-[calc(100vh-5rem)] max-w-3xl items-center justify-center p-0 sm:min-h-[calc(100vh-8rem)]'
    >
      <section
        class='w-full max-w-xl overflow-hidden rounded-xl bg-[#FAF9F6] shadow-[0_4px_12px_rgba(0,0,0,0.05)]'
      >
        <div class='px-6 pt-10 sm:px-8'>
          <img
            src='https://xzwtdlytxsdligefgomo.supabase.co/storage/v1/object/sign/logos/logoLapware.png?token=eyJraWQiOiJzdG9yYWdlLXVybC1zaWduaW5nLWtleV9mODAxZDFkMy00MTU0LTQ0MDctYTNlNS1lN2U3ZGVjYmExZmUiLCJhbGciOiJIUzI1NiJ9.eyJ1cmwiOiJsb2dvcy9sb2dvTGFwd2FyZS5wbmciLCJpYXQiOjE3ODAyNDc4OTUsImV4cCI6MjA5MTI4Nzg5NX0.bghQ3AGkIadRkz84cuZLyRwgig8Vm36Hc4G054ZwDVc'
            alt='Storis'
            width='128'
            height='128'
            class='mx-auto block w-24 rounded-xl sm:w-28'
          />
        </div>

        <div class='px-6 pb-4 pt-6 text-center sm:px-8'>
          <h1
            class='m-0 font-heading text-3xl font-extrabold tracking-tight text-[#111A2D] sm:text-4xl'
          >
            Email Confirmed
          </h1>

          <p
            class='mx-auto mt-4 max-w-md text-base leading-relaxed text-[#5E6982]'
          >
            Your email address has been verified successfully. You can now
            return to Storis and keep reading, saving, and generating bedtime
            stories for your family.
          </p>
        </div>

        <footer
          class='border-t border-[#DEE2F5] bg-[#ECEEF9] px-6 py-6 text-center sm:px-8'
        >
          <p class='m-0 text-xs text-[#5E6982]'>&copy; Lapwing Software</p>

          <p class='mt-2 text-xs'>
            <a
              href='/storis/privacy-policy'
              class='font-medium text-[#6071C9] no-underline hover:underline'
            >
              Privacy Policy
            </a>
            <span class='mx-2 text-[#5E6982]'>|</span>
            <a
              href='/storis/terms-and-conditions'
              class='font-medium text-[#6071C9] no-underline hover:underline'
            >
              Terms &amp; Conditions
            </a>
          </p>
        </footer>
      </section>
    </main>
  </body>
</html>
